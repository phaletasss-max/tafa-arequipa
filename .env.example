# TAFA Arequipa — variables de entorno (Vite)
# Copiar a `.env.local` para desarrollo y configurar en Vercel para producción.
# Todas las variables VITE_* se incrustan en el bundle del navegador:
# NUNCA poner aquí la service_role key ni secretos de servidor.

# Proyecto Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica

# Base pública del sitio — se usa para generar las URLs de los carteles QR
VITE_PUBLIC_SITE_URL=https://tafaqp.vercel.app
